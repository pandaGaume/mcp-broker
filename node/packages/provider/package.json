{
    "name": "@cyanmycelium/mcp-broker-provider",
    "version": "0.1.0",
    "description": "Provider side of the CyanMycelium MCP broker tunnel: publish an MCP server to a broker slot over the shared envelope protocol.",
    "type": "module",
    "license": "Apache-2.0",
    "author": "Guillaume Pelletier (CyanMycelium)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pandaGaume/mcp-broker.git",
        "directory": "node/packages/provider"
    },
    "homepage": "https://github.com/pandaGaume/mcp-broker#readme",
    "bugs": {
        "url": "https://github.com/pandaGaume/mcp-broker/issues"
    },
    "keywords": [
        "mcp",
        "model-context-protocol",
        "broker",
        "provider",
        "tunnel",
        "websocket",
        "transport",
        "cyanmycelium"
    ],
    "engines": {
        "node": ">=20.11.0"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src",
        "LICENSE",
        "README.md"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./protocol": {
            "types": "./dist/protocol/index.d.ts",
            "import": "./dist/protocol/index.js",
            "default": "./dist/protocol/index.js"
        }
    },
    "scripts": {
        "build": "tsup",
        "clean": "rimraf dist",
        "watch": "tsup --watch",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
        "format": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
        "format:fix": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
        "prepublishOnly": "npm run lint && npm run build && npm test"
    },
    "peerDependencies": {
        "@cyanmycelium/mcp-core": "^0.7.0"
    },
    "devDependencies": {
        "@cyanmycelium/mcp-core": "^0.7.0",
        "@types/node": "^20.11.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.0",
        "prettier": "^3.2.0",
        "rimraf": "~6.0.1",
        "tslib": "^2.8.1",
        "tsup": "^8.5.1",
        "typescript": "^5.4.0",
        "vitest": "^4.1.9"
    }
}
