{
    "name": "@cyanmycelium/mcp-broker-workspace",
    "version": "0.0.0",
    "private": true,
    "description": "npm workspace root for the CyanMycelium MCP broker and its client-side tunnel transports.",
    "license": "Apache-2.0",
    "author": "Guillaume Pelletier (CyanMycelium)",
    "type": "module",
    "engines": {
        "node": ">=20.11.0"
    },
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "npm run build --workspaces --if-present",
        "clean": "npm run clean --workspaces --if-present",
        "compile": "npm run compile --workspaces --if-present",
        "test": "npm run test --workspaces --if-present",
        "lint": "npm run lint --workspaces --if-present",
        "lint:fix": "npm run lint:fix --workspaces --if-present",
        "format": "npm run format --workspaces --if-present",
        "format:fix": "npm run format:fix --workspaces --if-present"
    }
}
